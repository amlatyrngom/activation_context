+def _cache_offset(kwargs: dict) -> int:
+    cache = kwargs.get("past_key_values")
+    if cache is None:
+        cache = kwargs.get("past_key_value")
+    if cache is None or not hasattr(cache, "get_seq_length"):
+        return 0
+    return int(cache.get_seq_length())

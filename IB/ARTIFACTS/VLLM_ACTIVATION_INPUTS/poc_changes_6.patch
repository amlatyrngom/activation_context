+    seen = {}
+    def record(name):
+        def hook(module, args, output):
+            seen.setdefault(name, []).append(output.detach().clone())
+        return hook
+    handles = [block.self_attn.k_norm.register_forward_hook(record("k")), block.self_attn.v_proj.register_forward_hook(record("v"))]
+    try:

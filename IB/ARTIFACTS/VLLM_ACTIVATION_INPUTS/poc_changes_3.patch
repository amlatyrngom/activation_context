+        if passage.shape[0] == 0:
+            return rows
+        split = lambda tensor, n: tensor.view(n, self.heads, -1).transpose(0, 1)                   # [heads, n, r / heads]
+        q, k, v = split(self.query(self.norm(rows)), rows.shape[0]), split(self.key(self.norm(passage)), passage.shape[0]), split(self.value(self.norm(passage)), passage.shape[0])

+        self.files: dict[str, str] = {}
+        self.copies: list[tuple[str, str]] = []
+        self.dockerfile_path = dockerfile_path
+        self.alive = True
+        FakeEnv.instances.append(self)
+
+    def write_file(self, path, content):
+        self.files[path] = content
+        return True
